# Kopie nach deploy/haus.env und anpassen (haus.env ist gitignored).
# Server (SSH-Ziel fuer push.sh), seine feste IP, Heimnetz und Router
PI=benutzer@servername
PI_IP=192.168.1.50
LAN=192.168.1.0/24
FRITZBOX=192.168.1.1
# IP-Adressen der Radios (feste Adresse im Router vergeben), durch Leerzeichen getrennt
RADIO_IPS="192.168.1.26"
PORT=8095
# ja: jede Anfrage ins Journal und durchgereichte Antworten als Dateien (privat!)
MITSCHNITT=ja
TESTMENUE=nein
UMLAUTE=umschreiben
# So nennt das Radio die Oberflaeche in seiner Anzeige (Name des Servers im Heimnetz)
PORTAL_URL=http://servername:8095
